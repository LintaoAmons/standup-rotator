{
  "name": "standup-rotator",
  "version": "0.1.0",
  "private": true,
  "description": "Picks the next standup facilitator. Single Cloudflare Worker + D1, fully serverless.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute DB --local --file=schema.sql",
    "seed:local": "wrangler d1 execute DB --local --file=seed.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.20.0"
  }
}
